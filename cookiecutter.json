{
  "artifact": "my-project",
  "title": "My Project",
  "description": "Nothing fancy. Yet.",
  "license": [
    "MIT",
    "Apache-2.0",
    "BSD-2-Clause",
    "BSD-3-Clause"
  ],
  "packaging": [
    "python",
    "debian-jammy-amd64",
    "debian-jammy-arm64",
    "debian-noble-amd64",
    "debian-noble-arm64",
    "debian-resolute-amd64",
    "debian-resolute-arm64"
  ],
  "__version": "0.1.0",
  "__python": "3.12",
  "__module": "{{ cookiecutter.artifact | replace('-', '_') }}",
  "__title": "{{ ' '.join(cookiecutter.title.split()).removesuffix('.').rstrip() }}",
  "__description": "{% set d = ' '.join(cookiecutter.description.split()) %}{{ d if not d or d[-1] in '.!?' else d ~ '.' }}",
  "__packaging": "{{ cookiecutter.packaging.split('-')[0] }}",
  "__codename": "{{ cookiecutter.packaging.split('-')[1] if cookiecutter.packaging.startswith('debian-') else '' }}",
  "__arch": "{{ cookiecutter.packaging.split('-')[2] if cookiecutter.packaging.startswith('debian-') else '' }}",
  "__debhelper": "13",
  "__standards": "{{ {'jammy': '4.6.0', 'noble': '4.7.0', 'resolute': '4.7.4'}[cookiecutter.__codename] if cookiecutter.__packaging == 'debian' else '' }}",
  "__author": "{{ git_config('user.name') }}",
  "__email": "{{ git_config('user.email') }}",
  "_extensions": [
    "extensions.git.GitExtension"
  ],
  "__prompts__": {
    "packaging": {
      "__prompt__": "How to ship the project",
      "python": "Python package",
      "debian-jammy-amd64": "Debian package for Ubuntu jammy, amd64",
      "debian-jammy-arm64": "Debian package for Ubuntu jammy, arm64",
      "debian-noble-amd64": "Debian package for Ubuntu noble, amd64",
      "debian-noble-arm64": "Debian package for Ubuntu noble, arm64",
      "debian-resolute-amd64": "Debian package for Ubuntu resolute, amd64",
      "debian-resolute-arm64": "Debian package for Ubuntu resolute, arm64"
    }
  }
}
